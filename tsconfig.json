{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    "src/ui"
  ]
}