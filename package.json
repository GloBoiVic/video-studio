{
  "name": "video-studio",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-native desktop video editor for macOS: you direct, a local coding agent edits.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "app": "electron .",
    "selftest": "node scripts/build.mjs && VIDEO_STUDIO_HEADLESS=1 VIDEO_STUDIO_SELFTEST=$PWD/test-results/selftest.json electron .",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p src/ui"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "openfilm": "^0.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}